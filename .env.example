# Copy this file to .env and replace every value.
# .env is gitignored; this example file is committed so everyone knows
# which variables exist.

# --- Postgres (read by docker-compose.yml) ---
# Passwords are applied only when the database is first created.
# To change them later, reset the volume: docker compose down -v
POSTGRES_SUPERUSER_PASSWORD=change-me
MIGRATOR_PASSWORD=change-me
APP_PASSWORD=change-me

# --- API (validated in apps/api/src/config/env.ts) ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Uses the app role; the password must match APP_PASSWORD above.
DATABASE_URL=postgres://perspective_app:change-me@127.0.0.1:5432/perspective
