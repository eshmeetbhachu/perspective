# Copy this file to .env and replace every value.
# .env is gitignored; this example file is committed so everyone knows
# which variables exist.

# --- Postgres (read by docker-compose.yml) ---
# Passwords are applied only when the database is first created.
# To change them later, reset the volume: docker compose down -v
POSTGRES_SUPERUSER_PASSWORD=change-me
MIGRATOR_PASSWORD=change-me
APP_PASSWORD=change-me

# --- API (validated in apps/api/src/config/env.ts) ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# The web app's address; only requests from it may change data (CSRF, CORS).
WEB_ORIGIN=http://localhost:5173
# Uses the app role; the password must match APP_PASSWORD above.
DATABASE_URL=postgres://perspective_app:change-me@127.0.0.1:5432/perspective

# --- Sign in with Google (optional; see "Sign in with Google" in README.md) ---
# Leave empty to turn Google sign-in off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# --- Migrations (read by apps/api/drizzle.config.ts, never by the server) ---
# Uses the migrator role; the password must match MIGRATOR_PASSWORD above.
MIGRATION_DATABASE_URL=postgres://perspective_migrator:change-me@127.0.0.1:5432/perspective
