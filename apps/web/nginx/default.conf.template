# ${API_UPSTREAM} is filled in when the container starts, e.g. http://api:3000
server {
  listen 8080;
  root /usr/share/nginx/html;

  gzip on;
  gzip_types text/css application/javascript image/svg+xml;

  # Same as the Vite dev proxy: /api/questions -> API's /questions, so the
  # browser only ever talks to one origin and cookies stay first-party.
  location /api/ {
    proxy_pass ${API_UPSTREAM}/;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # File names contain a content hash, so they can be cached forever.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # Every other path is a page of the single-page app.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
