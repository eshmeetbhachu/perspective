{
  "name": "@perspective/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsx scripts/build.ts",
    "start": "node --enable-source-maps dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:deployed": "node --enable-source-maps dist/migrate.js",
    "db:setup-roles": "tsx scripts/setup-roles.ts",
    "test": "vitest run",
    "set-role": "tsx --env-file=../../.env scripts/set-role.ts",
    "recompute-scores": "tsx --env-file=../../.env scripts/recompute-scores.ts",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx --env-file=../../.env scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.1",
    "@node-rs/argon2": "^2.2.1",
    "@perspective/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "nodemailer": "^10.1.7",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
