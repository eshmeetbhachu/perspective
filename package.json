{
  "name": "perspective",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @perspective/api dev",
    "dev:web": "pnpm --filter @perspective/web dev",
    "db:generate": "pnpm --filter @perspective/api db:generate",
    "db:migrate": "pnpm --filter @perspective/api db:migrate",
    "db:setup-roles": "pnpm --filter @perspective/api db:setup-roles",
    "set-role": "pnpm --filter @perspective/api set-role",
    "recompute-scores": "pnpm --filter @perspective/api recompute-scores",
    "seed": "pnpm --filter @perspective/api seed",
    "typecheck": "tsc -p packages/shared && tsc -p apps/api && tsc -p apps/web && tsc -p apps/web/tsconfig.node.json && tsc -p e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --filter=!@perspective/e2e test",
    "test:coverage": "pnpm --filter @perspective/api test:coverage",
    "build": "pnpm --filter @perspective/web build",
    "test:e2e": "pnpm --filter @perspective/e2e test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
